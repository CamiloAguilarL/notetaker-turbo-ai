# PostgreSQL (local Docker service)
POSTGRES_DB=turbo_notes
POSTGRES_USER=turbo_notes
POSTGRES_PASSWORD=turbo_notes_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://turbo_notes:turbo_notes_local_only@db:5432/turbo_notes

# Django API
DJANGO_SECRET_KEY=local-only-change-me-before-any-non-local-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Next.js
# Browser-facing URL. This value is intentionally public and bundled by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-only URL used by Next.js while running inside the Compose network.
API_INTERNAL_URL=http://api:8000/api/v1
